// Kopieren nach Config.xcconfig (wird nicht eingecheckt) und Werte eintragen.
// Achtung: In .xcconfig startet "//" einen Kommentar – daher der $()-Trick in der URL.

SUPABASE_URL = https:/$()/DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY = DEIN_PUBLISHABLE_KEY
MAPBOX_ACCESS_TOKEN = pk.DEIN_MAPBOX_PUBLIC_TOKEN
DEVELOPMENT_TEAM = DEINE_TEAM_ID
MEETERZ_PUSH_ENV = development

// ── Modus ────────────────────────────────────────────────────
// A) Kostenlose Apple-ID (Personal Team)
//    iPhone: Test-Login mit E-Mail + Passwort, keine Apple-Anmeldung, kein Push, kein CarPlay im Auto.
//    Simulator: zusätzlich CarPlay-Simulator nutzbar.
MEETERZ_FLAGS = DEV_LOGIN
MEETERZ_ENTITLEMENTS =
MEETERZ_ENTITLEMENTS[sdk=iphonesimulator*] = Meeterz/Meeterz-Simulator.entitlements

// B) Bezahlter Developer Account (oberen Block auskommentieren, diesen aktivieren)
// MEETERZ_FLAGS =
// MEETERZ_ENTITLEMENTS = Meeterz/Meeterz.entitlements

// C) Wie B, sobald Apple das CarPlay-Entitlement freigegeben hat
// MEETERZ_FLAGS =
// MEETERZ_ENTITLEMENTS = Meeterz/Meeterz-CarPlay.entitlements
