    "Profil, Freundschaften, Standorte, Routen und Treffen werden endgültig gelöscht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, Freundschaften, Standorte, Routen und Treffen werden endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, friendships, locations, routes and meetups will be permanently deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil, les amitiés, les positions, les itinéraires et les rendez-vous seront définitivement supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán definitivamente el perfil, las amistades, las ubicaciones, las rutas y las quedadas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil, as amizades, as localizações, as rotas e os encontros serão eliminados definitivamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, arkadaşlıklar, konumlar, rotalar ve buluşmalar kalıcı olarak silinir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo, amicizie, posizioni, percorsi e incontri verranno eliminati definitivamente."
          }
        }
      }
    },
