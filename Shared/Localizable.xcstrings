    "Gerade teilt niemand seinen Standort. Für einen fairen Treffpunkt braucht Meeterz die Standorte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade teilt niemand seinen Standort. Für einen fairen Treffpunkt braucht Meeterz die Standorte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody is sharing their location right now. Meeterz needs locations to find a fair meeting point."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne partage sa position pour le moment. Meeterz a besoin des positions pour un point de rendez-vous équitable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora nadie comparte su ubicación. Meeterz necesita las ubicaciones para un punto de encuentro justo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento ninguém partilha a localização. O Meeterz precisa das localizações para um ponto de encontro justo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an kimse konumunu paylaşmıyor. Adil bir buluşma noktası için Meeterz konumlara ihtiyaç duyar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento nessuno condivide la posizione. Per un punto d’incontro equo Meeterz ha bisogno delle posizioni."
          }
        }
      }
    },
