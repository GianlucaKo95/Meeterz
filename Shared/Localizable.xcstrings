    "Sendet anonymisierte Standort- und Nutzungsdaten an Mapbox, damit Straßen, Abbiegeverbote und Verkehrsdaten besser werden. Freiwillig, standardmäßig aus.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet anonymisierte Standort- und Nutzungsdaten an Mapbox, damit Straßen, Abbiegeverbote und Verkehrsdaten besser werden. Freiwillig, standardmäßig aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends de-identified location and usage data to Mapbox to improve roads, turn restrictions and traffic data. Optional, off by default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie à Mapbox des données de position et d’utilisation anonymisées pour améliorer les routes, les interdictions de tourner et les données de trafic. Facultatif, désactivé par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía a Mapbox datos de ubicación y uso anonimizados para mejorar carreteras, prohibiciones de giro y datos de tráfico. Opcional, desactivado por defecto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia à Mapbox dados de localização e utilização anonimizados para melhorar estradas, proibições de viragem e dados de trânsito. Opcional, desligado por predefinição."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolları, dönüş yasaklarını ve trafik verilerini iyileştirmek için Mapbox’a anonimleştirilmiş konum ve kullanım verileri gönderir. İsteğe bağlı, varsayılan olarak kapalı."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia a Mapbox dati di posizione e utilizzo anonimizzati per migliorare strade, divieti di svolta e dati sul traffico. Facoltativo, disattivato per impostazione predefinita."
          }
        }
      }
    },
