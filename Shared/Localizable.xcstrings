    "Dein Foto sehen nur Freunde, deren Anfrage du angenommen hast. Ohne Foto erscheinen deine Initialen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Foto sehen nur Freunde, deren Anfrage du angenommen hast. Ohne Foto erscheinen deine Initialen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only friends whose request you accepted can see your photo. Without a photo, your initials are shown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les amis dont tu as accepté la demande voient ta photo. Sans photo, tes initiales s’affichent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los amigos cuya solicitud aceptaste ven tu foto. Sin foto se muestran tus iniciales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os amigos cujo pedido aceitaste veem a tua foto. Sem foto, aparecem as tuas iniciais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafını yalnızca isteğini kabul ettiğin arkadaşlar görür. Fotoğraf yoksa baş harflerin görünür."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli amici di cui hai accettato la richiesta vedono la tua foto. Senza foto compaiono le tue iniziali."
          }
        }
      }
    },
    "Dein Standort ist für diesen Freund verborgen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort ist für diesen Freund verborgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is hidden from this friend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position est masquée pour cet ami."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación está oculta para este amigo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua localização está oculta para este amigo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun bu arkadaştan gizlendi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione è nascosta a questo amico."
          }
        }
      }
    },
    "Dein Standort ist gerade nicht bekannt.": {
      "localizations": {
