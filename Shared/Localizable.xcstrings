    "Gelernt aus deinen Fahrten mit Live-Daten. Ab %lld km je Bereich rechnet die Ladeplanung damit statt mit dem Durchschnittswert (%@ kWh/100 km).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelernt aus deinen Fahrten mit Live-Daten. Ab %lld km je Bereich rechnet die Ladeplanung damit statt mit dem Durchschnittswert (%@ kWh/100 km)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learned from your drives with live data. From %lld km per range, charge planning uses it instead of the average (%@ kWh/100 km)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appris de tes trajets avec données en direct. À partir de %lld km par plage, la planification l’utilise au lieu de la moyenne (%@ kWh/100 km)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido de tus viajes con datos en vivo. A partir de %lld km por tramo, la planificación lo usa en lugar del valor medio (%@ kWh/100 km)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendido das tuas viagens com dados ao vivo. A partir de %lld km por faixa, o planeamento usa-o em vez da média (%@ kWh/100 km)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı verili sürüşlerinden öğrenildi. Aralık başına %lld km’den itibaren şarj planı ortalama yerine bunu kullanır (%@ kWh/100 km)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appreso dai tuoi viaggi con dati live. Da %lld km per fascia, la pianificazione lo usa al posto della media (%@ kWh/100 km)."
          }
        }
      }
    },
    "Geneigt, mit Gebäuden": {
      "localizations": {
