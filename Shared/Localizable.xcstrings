    "Deine Freunde sehen deine Route, solange du teilst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Freunde sehen deine Route, solange du teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your friends see your route while you share."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes amis voient ton itinéraire tant que tu partages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos ven tu ruta mientras compartes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus amigos veem a tua rota enquanto partilhas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaştığın sürece arkadaşların rotanı görür."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi amici vedono il tuo percorso finché condividi."
          }
        }
      }
    },
    "Den Akkustand stellst du beim Losfahren in CarPlay unter „Mehr“ ein. Reicht er nicht bis zum Ziel, schlägt Meeterz Ladesäulen entlang der Route vor (mit 10 % Reserve).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Akkustand stellst du beim Losfahren in CarPlay unter „Mehr“ ein. Reicht er nicht bis zum Ziel, schlägt Meeterz Ladesäulen entlang der Route vor (mit 10 % Reserve)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the battery level in CarPlay under “More” when you set off. If it won’t reach the destination, Meeterz suggests chargers along the route (with a 10 % reserve)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle le niveau de batterie dans CarPlay sous « Plus » au départ. S’il ne suffit pas, Meeterz propose des bornes sur l’itinéraire (avec 10 % de réserve)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el nivel de batería en CarPlay en «Más» al salir. Si no llega al destino, Meeterz sugiere cargadores en la ruta (con un 10 % de reserva)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o nível da bateria no CarPlay em «Mais» ao partir. Se não chegar ao destino, o Meeterz sugere postos ao longo da rota (com 10 % de reserva)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batarya seviyesini yola çıkarken CarPlay’de “Diğer” altında ayarla. Hedefe yetmezse Meeterz rota üzerinde şarj istasyonları önerir (%10 yedekle)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il livello della batteria in CarPlay sotto «Altro» alla partenza. Se non basta, Meeterz propone colonnine lungo il percorso (con il 10 % di riserva)."
          }
        }
      }
    },
