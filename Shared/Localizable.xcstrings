    "%@. Werte sind Durchschnittswerte; Meeterz lernt mit der Zeit aus deinen Fahrten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Werte sind Durchschnittswerte; Meeterz lernt mit der Zeit aus deinen Fahrten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Values are averages; Meeterz learns from your drives over time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Ce sont des valeurs moyennes ; Meeterz apprend de tes trajets au fil du temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Son valores medios; Meeterz aprende de tus viajes con el tiempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. São valores médios; o Meeterz aprende com as tuas viagens ao longo do tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Değerler ortalamadır; Meeterz zamanla sürüşlerinden öğrenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Sono valori medi; Meeterz impara dai tuoi viaggi col tempo."
          }
        }
      }
    },
