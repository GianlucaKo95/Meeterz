    "Inkognito aktiv – Freunde sehen weder deinen Standort noch deine Route.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkognito aktiv – Freunde sehen weder deinen Standort noch deine Route."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incognito on – friends see neither your location nor your route."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incognito activé – tes amis ne voient ni ta position ni ton itinéraire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incógnito activado: tus amigos no ven ni tu ubicación ni tu ruta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incógnito ativo – os amigos não veem a tua localização nem a tua rota."
