    "Die Eingeladenen können zusagen oder ablehnen. Bei einer Zusage wird der Ort bei ihnen als Ziel vorgeschlagen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Eingeladenen können zusagen oder ablehnen. Bei einer Zusage wird der Ort bei ihnen als Ziel vorgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitees can accept or decline. If they accept, the place is suggested to them as a destination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invités peuvent accepter ou refuser. S’ils acceptent, le lieu leur est proposé comme destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los invitados pueden aceptar o rechazar. Si aceptan, se les propone el lugar como destino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os convidados podem aceitar ou recusar. Se aceitarem, o local é-lhes sugerido como destino."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet edilenler kabul ya da reddedebilir. Kabul edenlere yer, hedef olarak önerilir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli invitati possono accettare o rifiutare. Se accettano, il luogo viene proposto loro come destinazione."
          }
        }
      }
    },
    "Die Fahrzeiten konnten gerade nicht berechnet werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrzeiten konnten gerade nicht berechnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel times couldn’t be calculated right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les temps de trajet n’ont pas pu être calculés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido calcular los tiempos de viaje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível calcular os tempos de viagem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolculuk süreleri şu an hesaplanamadı."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile calcolare i tempi di percorrenza."
          }
        }
      }
    },
    "Die Fortbewegungsart kannst du je Person ändern – zu Fuß oder mit dem Rad kommen nur Orte ohne Autobahn infrage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fortbewegungsart kannst du je Person ändern – zu Fuß oder mit dem Rad kommen nur Orte ohne Autobahn infrage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the travel mode per person – on foot or by bike, only places away from motorways qualify."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux changer le mode de déplacement par personne – à pied ou à vélo, seuls les lieux hors autoroute conviennent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el medio de transporte por persona: a pie o en bici solo valen lugares sin autopista."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes mudar o meio de transporte por pessoa – a pé ou de bicicleta, só servem locais sem autoestrada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulaşım şeklini kişi başına değiştirebilirsin – yürüyerek veya bisikletle yalnızca otoyol dışındaki yerler uygundur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare il mezzo per ogni persona: a piedi o in bici vanno bene solo luoghi lontani dall’autostrada."
          }
        }
      }
    },
    "Die Geräte-ID wird ungültig, gespeicherte Werte werden gelöscht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräte-ID wird ungültig, gespeicherte Werte werden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device ID becomes invalid and stored values are deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant de l’appareil devient invalide, les valeurs enregistrées sont supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID del dispositivo deja de ser válido y se borran los valores guardados."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID do dispositivo fica inválido e os valores guardados são apagados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz kimliği geçersiz olur, kayıtlı değerler silinir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID del dispositivo non sarà più valido e i valori salvati verranno eliminati."
          }
        }
      }
    },
