    "Sieh, wo deine Freunde unterwegs sind –\nund triff sie auf dem Weg.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wo deine Freunde unterwegs sind –\nund triff sie auf dem Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See where your friends are on the road –\nand meet them along the way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vois où tes amis sont en route –\net retrouve-les en chemin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira por dónde van tus amigos\ny quedad por el camino."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê por onde andam os teus amigos –\ne encontra-os pelo caminho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşlarının yolda nerede olduğunu gör –\nve onlarla yolda buluş."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda dove sono in viaggio i tuoi amici\ne incontrali lungo la strada."
          }
        }
      }
    },
    "Sortiert nach der längsten Anfahrt: Niemand soll viel weiter fahren als die anderen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach der längsten Anfahrt: Niemand soll viel weiter fahren als die anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorted by the longest journey: nobody should have to travel much farther than the others."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trié selon le trajet le plus long : personne ne doit rouler beaucoup plus que les autres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenado por el trayecto más largo: nadie debe recorrer mucho más que los demás."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenado pelo trajeto mais longo: ninguém deve viajar muito mais do que os outros."
          }
        },
        "tr": {
          "stringUnit": {
