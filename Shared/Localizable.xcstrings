            "state": "translated",
            "value": "Trafic actuel inclus. Tes amis voient ton itinéraire tant que tu partages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye el tráfico actual. Tus amigos ven tu ruta mientras compartes."
          }
        },
        "pt": {
