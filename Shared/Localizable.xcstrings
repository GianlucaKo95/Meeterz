    "Das Teilen endet 15 Minuten nach der Ankunft deiner nächsten Fahrt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen endet 15 Minuten nach der Ankunft deiner nächsten Fahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing ends 15 minutes after you arrive on your next drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage s’arrête 15 minutes après l’arrivée de ton prochain trajet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir termina 15 minutos después de llegar en tu próximo viaje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A partilha termina 15 minutos após a chegada da tua próxima viagem."
