  "sourceLanguage": "de",
  "strings": {
    " Mit „Routen verbergen“ sehen Freunde nie, wohin du fährst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Mit „Routen verbergen“ sehen Freunde nie, wohin du fährst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " With “Hide routes”, friends never see where you’re going."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Avec « Masquer les itinéraires », tes amis ne voient jamais où tu vas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Con «Ocultar rutas», tus amigos nunca ven adónde vas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Com «Ocultar rotas», os teus amigos nunca veem para onde vais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " “Rotaları gizle” açıkken arkadaşların nereye gittiğini asla görmez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Con «Nascondi percorsi» gli amici non vedono mai dove stai andando."
          }
        }
      }
    },
