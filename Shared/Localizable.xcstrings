    "Dein Auto fehlt? Batterie, Verbrauch und Ladeleistung selbst eintragen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Auto fehlt? Batterie, Verbrauch und Ladeleistung selbst eintragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your car is missing? Enter battery, consumption and charging power yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voiture n’est pas là ? Saisis toi-même batterie, consommation et puissance de charge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No está tu coche? Introduce tú mismo batería, consumo y potencia de carga."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu carro não está na lista? Introduz bateria, consumo e potência de carregamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araban listede yok mu? Batarya, tüketim ve şarj gücünü kendin gir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua auto non c’è? Inserisci tu batteria, consumo e potenza di ricarica."
          }
        }
      }
    },
