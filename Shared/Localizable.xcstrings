    "„Bin gleich da, bestell schon mal!“": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bin gleich da, bestell schon mal!“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Almost there, go ahead and order!”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« J’arrive, commande déjà ! »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¡Ya casi llego, ve pidiendo!»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Estou quase a chegar, podes ir pedindo!»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Az kaldı geliyorum, sen sipariş ver!”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Arrivo subito, ordina pure!»"
          }
        }
      }
    },
    "„Deal, wir sehen uns!“": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Deal, wir sehen uns!“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Deal, see you there!”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ça marche, à tout à l’heure ! »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¡Trato hecho, nos vemos!»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Combinado, até já!»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Anlaştık, görüşürüz!”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Affare fatto, ci vediamo!»"
          }
        }
      }
    },
    "„Hup mal, ich bin's!“": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Hup mal, ich bin's!“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Honk, it’s me!”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Klaxonne, c’est moi ! »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¡Pita, que soy yo!»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Buzina, sou eu!»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Korna çal, benim!”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Suona il clacson, sono io!»"
          }
        }
      }
    },
    "„Wo bleibst du denn?“": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wo bleibst du denn?“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Where are you?”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Tu es où ? »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Dónde te has metido?»"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Onde é que estás?»"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nerede kaldın?”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ma dove sei?»"
          }
        }
      }
    }
