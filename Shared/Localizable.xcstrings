    "Das hat nicht geklappt – ist die Datenbank-Änderung eingespielt?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat nicht geklappt – ist die Datenbank-Änderung eingespielt?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t work – has the database update been applied?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça n’a pas marché – la mise à jour de la base de données est-elle appliquée ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ha funcionado: ¿se ha aplicado la actualización de la base de datos?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não funcionou – a atualização da base de dados foi aplicada?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olmadı – veritabanı güncellemesi uygulandı mı?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha funzionato: l’aggiornamento del database è stato applicato?"
          }
        }
      }
    },
