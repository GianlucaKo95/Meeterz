    "Mit den Ladesäulen entlang der Route nicht planbar (Reichweite ca. %lld km). Meeterz kennt Schnelllader in Deutschland, den Nachbarländern und Italien.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Ladesäulen entlang der Route nicht planbar (Reichweite ca. %lld km). Meeterz kennt Schnelllader in Deutschland, den Nachbarländern und Italien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t be planned with the chargers along the route (range approx. %lld km). Meeterz knows fast chargers in Germany, its neighboring countries and Italy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible à planifier avec les bornes sur l’itinéraire (autonomie env. %lld km). Meeterz connaît les bornes rapides en Allemagne, dans les pays voisins et en Italie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede planificar con los cargadores de la ruta (autonomía aprox. %lld km). Meeterz conoce cargadores rápidos en Alemania, los países vecinos e Italia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível planear com os postos da rota (autonomia aprox. %lld km). O Meeterz conhece carregadores rápidos na Alemanha, nos países vizinhos e em Itália."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rota üzerindeki şarj istasyonlarıyla planlanamıyor (menzil yaklaşık %lld km). Meeterz Almanya, komşu ülkeler ve İtalya’daki hızlı şarj istasyonlarını bilir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pianificabile con le colonnine lungo il percorso (autonomia circa %lld km). Meeterz conosce le colonnine rapide in Germania, nei paesi confinanti e in Italia."
          }
        }
      }
    },
