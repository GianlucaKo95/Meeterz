    "Freunde sehen deinen Standort nicht mehr, bis du wieder teilst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde sehen deinen Standort nicht mehr, bis du wieder teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends no longer see your location until you share again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes amis ne voient plus ta position jusqu’à ce que tu partages à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos dejan de ver tu ubicación hasta que vuelvas a compartir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os amigos deixam de ver a tua localização até voltares a partilhar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar paylaşana kadar arkadaşların konumunu görmez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amici non vedono più la tua posizione finché non condividi di nuovo."
          }
        }
      }
    },
    "Freunde sehen dich, bis du das Teilen pausierst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde sehen dich, bis du das Teilen pausierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends see you until you pause sharing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes amis te voient jusqu’à ce que tu mettes le partage en pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos te ven hasta que pauses el compartir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os amigos veem-te até pausares a partilha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımı duraklatana kadar arkadaşların seni görür."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amici ti vedono finché non metti in pausa la condivisione."
          }
        }
      }
    },
    "Freunde sehen weder deinen Standort noch deine Route – und erfahren nicht, dass du inkognito bist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde sehen weder deinen Standort noch deine Route – und erfahren nicht, dass du inkognito bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends see neither your location nor your route – and won’t know you’re incognito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes amis ne voient ni ta position ni ton itinéraire – et ne savent pas que tu es incognito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos no ven ni tu ubicación ni tu ruta, y no saben que estás de incógnito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os amigos não veem a tua localização nem a tua rota – e não sabem que estás incógnito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşların ne konumunu ne rotanı görür – gizli olduğunu da bilmez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amici non vedono né la tua posizione né il tuo percorso, e non sanno che sei in incognito."
          }
        }
      }
    },
    "Freunde sehen weder deinen Standort noch deine Route. Nochmal aufrufen beendet es.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde sehen weder deinen Standort noch deine Route. Nochmal aufrufen beendet es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends see neither your location nor your route. Run it again to end it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes amis ne voient ni ta position ni ton itinéraire. Relance pour y mettre fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus amigos no ven ni tu ubicación ni tu ruta. Vuelve a ejecutarlo para terminar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os amigos não veem a tua localização nem a tua rota. Executa de novo para terminar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşların ne konumunu ne rotanı görür. Bitirmek için tekrar çalıştır."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli amici non vedono né la tua posizione né il tuo percorso. Eseguilo di nuovo per terminare."
          }
        }
      }
    },
