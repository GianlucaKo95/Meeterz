    "Gilt für Handy und Android Auto gleichermaßen und sofort, auch während der Fahrt. Satellit: Luftbild mit 3D-Gebäuden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Handy und Android Auto gleichermaßen und sofort, auch während der Fahrt. Satellit: Luftbild mit 3D-Gebäuden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to phone and Android Auto alike, instantly, even while driving. Satellite: aerial imagery with 3D buildings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique au téléphone et à Android Auto, immédiatement, même en roulant. Satellite : vue aérienne avec bâtiments 3D."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al móvil y a Android Auto por igual y al instante, incluso conduciendo. Satélite: imagen aérea con edificios 3D."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per telefono e Android Auto, subito, anche durante la guida. Satellite: immagine aerea con edifici 3D."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao telemóvel e ao Android Auto, de imediato, mesmo a conduzir. Satélite: imagem aérea com edifícios 3D."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ve Android Auto için aynı şekilde ve anında geçerlidir, sürüş sırasında da. Uydu: 3D binalı hava görüntüsü."
          }
        }
      }
    },
    "Gilt für alle Routen, auch in Android Auto und für den Ladeplan. Geht ein Ziel nur mit Maut oder Fähre, nimmt Meeterz die normale Route und sagt Bescheid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Routen, auch in Android Auto und für den Ladeplan. Geht ein Ziel nur mit Maut oder Fähre, nimmt Meeterz die normale Route und sagt Bescheid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to all routes, also in Android Auto and for the charging plan. If a destination needs tolls or a ferry, Meeterz takes the normal route and tells you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à tous les itinéraires, aussi dans Android Auto et pour le plan de recharge. Si une destination exige un péage ou un ferry, Meeterz prend l'itinéraire normal et vous prévient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todas las rutas, también en Android Auto y para el plan de carga. Si un destino solo es posible con peaje o ferry, Meeterz usa la ruta normal y te avisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per tutti i percorsi, anche in Android Auto e per il piano di ricarica. Se una destinazione richiede pedaggi o traghetto, Meeterz usa il percorso normale e ti avvisa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a todas as rotas, também no Android Auto e no plano de carregamento. Se um destino exigir portagens ou ferry, o Meeterz usa a rota normal e avisa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm rotalar için geçerlidir, Android Auto ve şarj planı dahil. Bir hedef yalnızca ücretli yol veya feribotla mümkünse Meeterz normal rotayı kullanır ve haber verir."
          }
        }
      }
    },
    "Lass uns Meeterz nutzen – dann sehen wir uns unterwegs auf der Karte.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns Meeterz nutzen – dann sehen wir uns unterwegs auf der Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's use Meeterz – then we'll see each other on the map on the go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisons Meeterz – on se verra sur la carte en route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usemos Meeterz – así nos vemos en el mapa por el camino."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiamo Meeterz – così ci vediamo sulla mappa in giro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos usar o Meeterz – assim vemo-nos no mapa pelo caminho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz kullanalım – yolda birbirimizi haritada görürüz."
          }
        }
      }
    },
    "Meeterz übernimmt Akkustand, Reichweite und Ladezustand live aus deinem Auto – über das Home-Assistant-Add-on „MG to ABRP Bridge“ (iSMART). Damit entfällt die Akku-Eingabe, und die Ladeplanung rechnet mit echten Werten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz übernimmt Akkustand, Reichweite und Ladezustand live aus deinem Auto – über das Home-Assistant-Add-on „MG to ABRP Bridge“ (iSMART). Damit entfällt die Akku-Eingabe, und die Ladeplanung rechnet mit echten Werten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz takes battery level, range and charging state live from your car – via the Home Assistant add-on “MG to ABRP Bridge” (iSMART). No more entering the battery level, and charge planning uses real values."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz récupère en direct le niveau de batterie, l'autonomie et l'état de charge de votre voiture – via l'add-on Home Assistant « MG to ABRP Bridge » (iSMART). Plus besoin de saisir la batterie, et le plan de recharge utilise des valeurs réelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz toma en vivo la batería, la autonomía y el estado de carga de tu coche – con el complemento de Home Assistant «MG to ABRP Bridge» (iSMART). Ya no hace falta introducir la batería y el plan de carga usa valores reales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz riceve in tempo reale livello batteria, autonomia e stato di ricarica dalla tua auto – tramite l'add-on Home Assistant «MG to ABRP Bridge» (iSMART). Niente più inserimento della batteria, e il piano di ricarica usa valori reali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Meeterz recebe ao vivo o nível de bateria, a autonomia e o estado de carga do teu carro – através do add-on Home Assistant «MG to ABRP Bridge» (iSMART). Deixas de introduzir a bateria e o plano de carregamento usa valores reais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeterz batarya seviyesini, menzili ve şarj durumunu aracından canlı alır – Home Assistant eklentisi “MG to ABRP Bridge” (iSMART) üzerinden. Batarya girişi gerekmez ve şarj planı gerçek değerlerle hesaplanır."
          }
        }
      }
    },
    "Nicht verfügbar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponible"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible"
          }
        },
        "it": {
          "stringUnit": {
