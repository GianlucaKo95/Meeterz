    "Mit dem zu dieser Uhrzeit üblichen Verkehr. Du bekommst 10 Minuten vor der Abfahrt eine Erinnerung.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem zu dieser Uhrzeit üblichen Verkehr. Du bekommst 10 Minuten vor der Abfahrt eine Erinnerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the traffic usual at that time. You'll get a reminder 10 minutes before leaving."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec le trafic habituel à cette heure. Vous recevrez un rappel 10 minutes avant le départ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tráfico habitual a esa hora. Recibirás un aviso 10 minutos antes de salir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o trânsito habitual a essa hora. Você receberá um lembrete 10 minutos antes da partida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O saatteki olağan trafikle. Kalkıştan 10 dakika önce hatırlatma alırsın."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il traffico abituale a quell’ora. Riceverai un promemoria 10 minuti prima della partenza."
          }
        }
      }
    },
