            "state": "translated",
            "value": "Android ayarlarında izinler"
          }
        }
      }
    },
    "Die Stimmen kommen von der Sprachausgabe deines Android-Geräts. Eine natürlichere Stimme lädst du dort unter „Sprachdaten installieren“.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmen kommen von der Sprachausgabe deines Android-Geräts. Eine natürlichere Stimme lädst du dort unter „Sprachdaten installieren“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voices come from your Android device's text-to-speech. Download a more natural voice there under “Install voice data”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix proviennent de la synthèse vocale de votre appareil Android. Téléchargez une voix plus naturelle sous « Installer les données vocales »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las voces vienen de la síntesis de voz de tu dispositivo Android. Descarga una voz más natural en «Instalar datos de voz»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci provengono dalla sintesi vocale del tuo dispositivo Android. Scarica una voce più naturale in «Installa dati vocali»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes vêm da síntese de voz do teu dispositivo Android. Descarrega uma voz mais natural em «Instalar dados de voz»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesler Android cihazının metin okuma özelliğinden gelir. Daha doğal bir sesi orada “Ses verilerini yükle” altından indirebilirsin."
          }
        }
      }
    },
    "Du: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du: %@"
          }
        },
