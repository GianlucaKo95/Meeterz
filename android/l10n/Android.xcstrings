    " · Fahrzeugdaten: Open EV Data (github.com/KilowattApp/open-ev-data). Werte sind Durchschnittswerte; Meeterz lernt mit der Zeit aus deinen Fahrten.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · Fahrzeugdaten: Open EV Data (github.com/KilowattApp/open-ev-data). Werte sind Durchschnittswerte; Meeterz lernt mit der Zeit aus deinen Fahrten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Vehicle data: Open EV Data (github.com/KilowattApp/open-ev-data). Values are averages; Meeterz learns from your drives over time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · Données véhicules : Open EV Data (github.com/KilowattApp/open-ev-data). Valeurs moyennes ; Meeterz apprend au fil de vos trajets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · Datos de vehículos: Open EV Data (github.com/KilowattApp/open-ev-data). Son valores medios; Meeterz aprende de tus viajes con el tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " · Dati veicoli: Open EV Data (github.com/KilowattApp/open-ev-data). Valori medi; Meeterz impara col tempo dai tuoi viaggi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " · Dados dos veículos: Open EV Data (github.com/KilowattApp/open-ev-data). Valores médios; o Meeterz aprende com as tuas viagens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " · Araç verileri: Open EV Data (github.com/KilowattApp/open-ev-data). Değerler ortalamadır; Meeterz zamanla sürüşlerinden öğrenir."
          }
        }
      }
    },
