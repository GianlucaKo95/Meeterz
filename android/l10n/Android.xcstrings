    "Keine Treffen geplant. Lade Freunde über ein Ziel ein („Freunde einladen“) oder plane ein Gruppen-Treffen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Treffen geplant. Lade Freunde über ein Ziel ein („Freunde einladen“) oder plane ein Gruppen-Treffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No meetups planned. Invite friends from a destination (“Invite friends”) or plan a group meetup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rendez-vous prévu. Invite des amis depuis une destination (« Inviter des amis ») ou planifie un rendez-vous de groupe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay quedadas. Invita a amigos desde un destino («Invitar amigos») o planea una quedada en grupo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun incontro in programma. Invita amici da una destinazione («Invita amici») o pianifica un incontro di gruppo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum encontro planeado. Convida amigos a partir de um destino («Convidar amigos») ou planeia um encontro de grupo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanmış buluşma yok. Bir hedeften arkadaş davet et („Arkadaş davet et“) veya grup buluşması planla."
          }
        }
      }
    },
