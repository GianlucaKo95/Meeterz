            "value": "Indisponível"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılamıyor"
          }
        }
      }
    },
    "Nimm bis zu 5 Sekunden auf. Nur Freunde, deren Anfrage du angenommen hast, hören sie – zum passenden Moment, auch im Auto. Ohne Aufnahme sagt die Sprachausgabe Bescheid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm bis zu 5 Sekunden auf. Nur Freunde, deren Anfrage du angenommen hast, hören sie – zum passenden Moment, auch im Auto. Ohne Aufnahme sagt die Sprachausgabe Bescheid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record up to 5 seconds. Only friends whose request you accepted hear them – at the right moment, also in the car. Without a recording, text-to-speech lets them know."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez jusqu'à 5 secondes. Seuls les amis dont vous avez accepté la demande les entendent – au bon moment, aussi en voiture. Sans enregistrement, la synthèse vocale prévient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba hasta 5 segundos. Solo los amigos cuya solicitud aceptaste los oyen – en el momento justo, también en el coche. Sin grabación, avisa la síntesis de voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra fino a 5 secondi. Li sentono solo gli amici di cui hai accettato la richiesta – al momento giusto, anche in auto. Senza registrazione avvisa la sintesi vocale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava até 5 segundos. Só os amigos cujo pedido aceitaste os ouvem – no momento certo, também no carro. Sem gravação, a síntese de voz avisa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saniyeye kadar kaydet. Yalnızca isteğini kabul ettiğin arkadaşlar duyar – doğru anda, arabada da. Kayıt yoksa metin okuma haber verir."
          }
        }
      }
    },
    "Protokoll ausblenden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokoll ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide log"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le journal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar registro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi registro"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar registo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğü gizle"
          }
        }
      }
    },
    "Reicht der Akku nicht bis zum Ziel, schlägt Meeterz Ladesäulen entlang der Route vor (mit 10 % Reserve).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reicht der Akku nicht bis zum Ziel, schlägt Meeterz Ladesäulen entlang der Route vor (mit 10 % Reserve)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the battery won't reach the destination, Meeterz suggests chargers along the route (with 10 % reserve)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la batterie ne suffit pas jusqu'à destination, Meeterz propose des bornes le long de l'itinéraire (avec 10 % de réserve)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la batería no llega al destino, Meeterz propone cargadores a lo largo de la ruta (con 10 % de reserva)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la batteria non basta fino alla destinazione, Meeterz propone colonnine lungo il percorso (con 10 % di riserva)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a bateria não chegar ao destino, o Meeterz sugere postos de carregamento ao longo da rota (com 10 % de reserva)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batarya hedefe yetmezse Meeterz rota boyunca şarj istasyonları önerir (%10 rezervle)."
          }
        }
      }
    },
    "Standort, Mitteilungen, Kalender und Mikrofon verwaltest du in den Android-Einstellungen der App.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort, Mitteilungen, Kalender und Mikrofon verwaltest du in den Android-Einstellungen der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage location, notifications, calendar and microphone in the app's Android settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez la position, les notifications, le calendrier et le micro dans les réglages Android de l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona ubicación, notificaciones, calendario y micrófono en los ajustes de Android de la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci posizione, notifiche, calendario e microfono nelle impostazioni Android dell'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere localização, notificações, calendário e microfone nas definições Android da app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum, bildirimler, takvim ve mikrofonu uygulamanın Android ayarlarından yönetirsin."
          }
        }
      }
    },
    "Weniger": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az"
          }
        }
      }
    },
    "Wie bei Google Maps schlägt Android Auto beim Einsteigen ein Ziel vor: einen Termin mit Ort, zu dem du bald losfahren musst, oder einen Ort, den du um diese Zeit oft ansteuerst. Die gelernten Orte bleiben nur auf diesem Gerät.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bei Google Maps schlägt Android Auto beim Einsteigen ein Ziel vor: einen Termin mit Ort, zu dem du bald losfahren musst, oder einen Ort, den du um diese Zeit oft ansteuerst. Die gelernten Orte bleiben nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like Google Maps, Android Auto suggests a destination when you get in: an event with a location you need to leave for soon, or a place you often head to at this time. Learned places stay on this device only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme Google Maps, Android Auto propose une destination au démarrage : un rendez-vous avec lieu pour lequel vous devez bientôt partir, ou un lieu où vous allez souvent à cette heure. Les lieux appris restent sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Google Maps, Android Auto propone un destino al subir: una cita con lugar a la que debes salir pronto, o un sitio al que sueles ir a esta hora. Los lugares aprendidos se quedan en este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come Google Maps, Android Auto propone una destinazione quando sali: un appuntamento con luogo per cui devi partire presto, o un posto dove vai spesso a quest'ora. I luoghi appresi restano su questo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal como o Google Maps, o Android Auto sugere um destino ao entrares: um compromisso com local para o qual tens de sair em breve, ou um sítio onde vais muitas vezes a esta hora. Os locais aprendidos ficam só neste dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Haritalar gibi Android Auto da bindiğinde bir hedef önerir: yakında çıkman gereken konumlu bir randevu ya da bu saatte sık gittiğin bir yer. Öğrenilen yerler yalnızca bu cihazda kalır."
          }
        }
      }
    },
    "unterwegs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "unterwegs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "on the way"
          }
        },
        "fr": {
          "stringUnit": {
