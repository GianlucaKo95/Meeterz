    "Berechtigungen in den Android-Einstellungen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen in den Android-Einstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions in Android settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisations dans les réglages Android"
          }
        },
        "es": {
          "stringUnit": {
