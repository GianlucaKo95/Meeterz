    "Du bekommst 10 Minuten vorher eine Erinnerung; die Fahrzeit wird bis dahin mit dem Verkehr nachgerechnet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst 10 Minuten vorher eine Erinnerung; die Fahrzeit wird bis dahin mit dem Verkehr nachgerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a reminder 10 minutes before; the travel time is updated with traffic until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevrez un rappel 10 minutes avant ; la durée est recalculée avec le trafic d’ici là."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibirás un aviso 10 minutos antes; hasta entonces el tiempo se recalcula con el tráfico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você receberá um lembrete 10 minutos antes; até lá o tempo é recalculado com o trânsito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 dakika önce hatırlatma alırsın; süre o zamana kadar trafiğe göre güncellenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceverai un promemoria 10 minuti prima; fino ad allora il tempo viene ricalcolato con il traffico."
          }
        }
      }
    },
