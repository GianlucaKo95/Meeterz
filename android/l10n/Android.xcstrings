    "Nimm bis zu 5 Sekunden auf. Nur Freunde, deren Anfrage du angenommen hast, hören sie. Ohne Aufnahme sagt die Sprachausgabe Bescheid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm bis zu 5 Sekunden auf. Nur Freunde, deren Anfrage du angenommen hast, hören sie. Ohne Aufnahme sagt die Sprachausgabe Bescheid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record up to 5 seconds. Only friends whose request you accepted hear them. Without a recording, the voice announces it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre jusqu'à 5 secondes. Seuls les amis dont tu as accepté la demande les entendent. Sans enregistrement, la voix l'annonce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba hasta 5 segundos. Solo los amigos cuya solicitud aceptaste los oyen. Sin grabación, avisa la voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra fino a 5 secondi. Le sentono solo gli amici di cui hai accettato la richiesta. Senza registrazione, avvisa la voce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava até 5 segundos. Só os amigos cujo pedido aceitaste os ouvem. Sem gravação, a voz avisa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saniyeye kadar kaydet. Yalnızca isteğini kabul ettiğin arkadaşlar duyar. Kayıt yoksa sesli asistan haber verir."
          }
        }
      }
    },
