            "value": "Permisos en los ajustes de Android"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizzazioni nelle impostazioni Android"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissões nas definições do Android"
          }
        },
        "tr": {
