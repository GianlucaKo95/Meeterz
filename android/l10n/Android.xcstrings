          }
        }
      }
    },
    "Zum passenden Moment, auch im Auto – Musik wird kurz leiser": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum passenden Moment, auch im Auto – Musik wird kurz leiser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the right moment, in the car too – music dips briefly"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au bon moment, même en voiture – la musique baisse brièvement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el momento justo, también en el coche: la música baja un momento"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento giusto, anche in auto – la musica si abbassa un attimo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No momento certo, também no carro – a música baixa por instantes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru anda, arabada da – müzik kısa süre kısılır"
          }
        }
      }
    },
